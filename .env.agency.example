# DZ23 Autonomous Trading Agency — modo seguro padrão
LIVE_TRADING=false
PAPER_TRADING=true
SHADOW_TRADING=false
REAL_MONEY_EXECUTION=false
LEGACY_BROKER_ORDER_ENABLED=false

# MT5: DEMO permitido apenas com terminal/conta demo configurados.
MT5_MODE=DEMO
# LIVE_TRADING_CONFIRM nunca deve ser usado em desenvolvimento.
# LIVE_TRADING_CONFIRM=EU AUTORIZO OPERAR COM DINHEIRO REAL

# Para produção controlada, o endpoint legado deve continuar false até
# existir integração completa com Decision -> RiskEngine -> ExecutionRouter.
