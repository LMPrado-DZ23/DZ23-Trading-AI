# ---------------------------------------------------------------------------
# DZ23 Trading Agency — variáveis do servidor. NENHUM segredo real neste
# arquivo: ele é versionado. Preencha no Coolify/host.
# ---------------------------------------------------------------------------
ACCESS_PASSWORD=troque-por-uma-senha-forte-de-20-caracteres
DATA_DIR=/data
# DATABASE_URL=postgresql://usuario:senha@postgres:5432/tradingagents
DESK_INTERVAL_SECONDS=300

# Pagamento PIX (Woovi) — obtenha no painel da Woovi e NUNCA versione
WOOVI_TOKEN=
WOOVI_WEBHOOK_PUBLIC_KEY=
# Webhook a cadastrar na Woovi: https://SEU-DOMINIO/v1/webhooks/woovi

# Login social (opcional) — segredos ficam só aqui, no host
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://SEU-DOMINIO/api/oauth/google/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=https://SEU-DOMINIO/api/auth/microsoft/callback

# Invariantes de segurança — não altere sem decisão explícita do dono
LIVE_TRADING=false
REAL_MONEY_EXECUTION=false
PAPER_TRADING=true
