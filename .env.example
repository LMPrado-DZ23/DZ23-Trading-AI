# DZ23 Trading AI — template de configuração. NENHUM segredo real neste
# arquivo: ele é versionado. Preencha valores de verdade no host (secret
# manager, painel Configuração ou variáveis de ambiente) — nunca no Git.
#
# A senha do dono NÃO vive aqui: o painel cria e guarda o hash Argon2id no
# primeiro uso (assistente visual). Arquivo de dados: DATA_DIR abaixo.

DATA_DIR=./data
DESK_INTERVAL_SECONDS=300

# --- APIs de IA externas (opcional) ---------------------------------------
# Informam análise (notícias, sentimento, macro, explicações); nunca enviam
# ordens. Preencha no host/secret manager, jamais versione.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=

# --- Corretoras (opcional) -------------------------------------------------
# As chaves de corretora são configuradas pelo painel (Configuração) e
# guardadas no host. Use chaves com SAQUE DESABILITADO. A operação real
# (LIVE) permanece bloqueada por construção.

# Invariantes de segurança — não altere sem decisão explícita do dono
LIVE_TRADING=false
REAL_MONEY_EXECUTION=false
PAPER_TRADING=true
