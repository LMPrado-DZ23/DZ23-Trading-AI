# ---------------------------------------------------------------------------
# DZ23 Trading Agency — variáveis do servidor. NENHUM segredo real neste
# arquivo: ele é versionado. Preencha no Coolify/host.
# ---------------------------------------------------------------------------
ACCESS_PASSWORD=troque-por-uma-senha-forte-de-20-caracteres
DATA_DIR=/data
# --- Banco de dados -------------------------------------------------------
# Opção A (recomendada): Supabase gerenciado. Pegue a senha em
#   Supabase → Settings → Database → Database password
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_REGION=us-east-1
# A chave service_role NÃO é necessária para o app (ele fala Postgres direto).
# Só preencha se quiser o diagnóstico REST em /v1/admin/database:
SUPABASE_SERVICE_KEY=
# Opção B: qualquer Postgres seu (vence sobre o Supabase se preenchida)
# DATABASE_URL=postgresql://usuario:senha@postgres:5432/tradingagents
DESK_INTERVAL_SECONDS=300

# Modo SaaS (vários clientes): ligue e gere uma chave de 32+ caracteres
# (ex.: openssl rand -hex 32). Sem ela o multi-tenant fica desligado e o
# painel avisa — o serviço NÃO cai.
MULTI_TENANT_ENABLED=true
TENANT_TOKEN_SIGNING_KEY=
SIGNUP_ENABLED=true

# Pagamento PIX (Woovi) — obtenha no painel da Woovi e NUNCA versione
WOOVI_TOKEN=
WOOVI_WEBHOOK_PUBLIC_KEY=
# Webhook a cadastrar na Woovi: https://SEU-DOMINIO/v1/webhooks/woovi

# Login social (opcional) — segredos ficam só aqui, no host
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://SEU-DOMINIO/api/oauth/google/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=https://SEU-DOMINIO/api/auth/microsoft/callback

# Invariantes de segurança — não altere sem decisão explícita do dono
LIVE_TRADING=false
REAL_MONEY_EXECUTION=false
PAPER_TRADING=true
