# Substitua app.example.com pelo domínio controlado por você.
# Caddy provisiona TLS automaticamente quando DNS e portas 80/443 estão corretos.
app.example.com {
    encode gzip
    reverse_proxy tradingagents:8080
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
