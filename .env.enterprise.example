# DZ23 Trading AI — servidor (Docker Compose / VM Linux ARM64, ex.: Oracle
# Cloud). Template; NUNCA commitar valores reais.
#
# A senha do dono é criada pelo assistente do painel no primeiro uso (hash
# Argon2id no DATA_DIR). Este produto é single-owner por instalação: não
# existe modo multi-tenant, cadastro nem cobrança.

# PostgreSQL (persistência do servidor)
POSTGRES_USER=dz23
POSTGRES_PASSWORD=defina-uma-senha-forte-fora-do-git
POSTGRES_DB=dz23
DATABASE_URL=postgresql://dz23:senha@postgres:5432/dz23

# Cache / vetores (opcional)
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# Proxy reverso confiável (onde o TLS termina). Sem esta variável,
# X-Forwarded-For é ignorado para impedir bypass de rate limit.
# TRUSTED_PROXY_NETWORKS=10.0.0.0/8

# Invariantes de segurança — manter bloqueado
LIVE_TRADING=false
REAL_MONEY_EXECUTION=false
PAPER_TRADING=true
SHADOW_TRADING=true
MT5_MODE=DEMO
LEGACY_BROKER_ORDER_ENABLED=false

# LLMs — preencher somente no secret manager do host
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
