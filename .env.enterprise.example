# DZ23 Enterprise / Multi-tenant — nunca commitar valores reais
MULTI_TENANT_ENABLED=true
TENANT_TOKEN_SIGNING_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
TENANT_BOOTSTRAP_TOKEN=gere-um-token-de-bootstrap-unico-e-rotacione-depois-do-primeiro-admin
ACCESS_PASSWORD=legado-desativado-quando-multi-tenant-estiver-ativo

# PostgreSQL
POSTGRES_USER=dz23
POSTGRES_PASSWORD=defina-uma-senha-forte-fora-do-git
POSTGRES_DB=dz23
DATABASE_URL=postgresql://dz23:senha@postgres:5432/dz23

# Cache / filas / vetores
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# Segurança operacional — manter bloqueado
LIVE_TRADING=false
REAL_MONEY_EXECUTION=false
PAPER_TRADING=true
SHADOW_TRADING=true
MT5_MODE=DEMO
LEGACY_BROKER_ORDER_ENABLED=false

# LLMs — preencher somente no secret manager
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
