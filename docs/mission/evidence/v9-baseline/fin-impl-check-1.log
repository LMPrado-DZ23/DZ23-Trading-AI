        reports = []
        states = []
        for _ in range(3):
            reports.append(_reconcile(
                desk, rec, status="closed", cumulative="1.5", remote_quantity="2",
                fills=[_remote_fill("2")],
            ))
            states.append(rec.state.value)
    
