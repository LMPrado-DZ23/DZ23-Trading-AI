# TradingAgents DZ23 platform runtime. Copy to a server-side secret store;
# never commit populated values.
TRADINGAGENTS_ENVIRONMENT=production
TRADINGAGENTS_PUBLIC_URL=https://trading.dz23.online
TRADINGAGENTS_ALLOWED_ORIGINS=https://trading.dz23.online
TRADINGAGENTS_TRUSTED_PROXY_NETWORKS=172.16.0.0/12

# Must authenticate directly as tradingagents_app. Configure the role password
# out-of-band after applying migrations; do not use postgres/service_role.
TRADINGAGENTS_DATABASE_URL=postgresql+psycopg://tradingagents_app:CHANGE_IN_SECRET_STORE@db.example:5432/postgres?sslmode=verify-full
TRADINGAGENTS_DATABASE_EXPECTED_ROLE=tradingagents_app
TRADINGAGENTS_REDIS_URL=rediss://:CHANGE_IN_SECRET_STORE@redis.example:6379/0

# Generate independently: at least 32 random bytes for the pepper and exactly
# 32 random bytes encoded as URL-safe base64 for the MFA encryption key.
TRADINGAGENTS_SESSION_TOKEN_PEPPER=CHANGE_IN_SECRET_STORE
TRADINGAGENTS_MFA_ENCRYPTION_KEY_B64=CHANGE_IN_SECRET_STORE

TRADINGAGENTS_SMTP_HOST=smtp.example.com
TRADINGAGENTS_SMTP_PORT=465
TRADINGAGENTS_SMTP_USERNAME=CHANGE_IN_SECRET_STORE
TRADINGAGENTS_SMTP_PASSWORD=CHANGE_IN_SECRET_STORE
TRADINGAGENTS_SMTP_SENDER=TradingAgents DZ23 <noreply@example.com>
TRADINGAGENTS_SMTP_IMPLICIT_TLS=true

TRADINGAGENTS_SUPABASE_PROJECT_REF=fkswahrxvmueowcjisnp
TRADINGAGENTS_SUPABASE_URL=https://fkswahrxvmueowcjisnp.supabase.co
TRADINGAGENTS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_CHANGE_IN_SECRET_STORE

# Production broker credentials use envelope encryption. The data-encryption
# key is wrapped by OpenBao Transit; no master key is stored in this process.
TRADINGAGENTS_BROKER_CREDENTIAL_PROVIDER=openbao_transit
TRADINGAGENTS_BROKER_TRANSIT_URL=https://openbao:8200
TRADINGAGENTS_BROKER_TRANSIT_KEY_NAME=tradingagents-broker-credentials
TRADINGAGENTS_BROKER_TRANSIT_TOKEN=CHANGE_IN_SECRET_STORE

TRADINGAGENTS_SESSION_TTL_SECONDS=43200
TRADINGAGENTS_RECOVERY_TTL_SECONDS=1800
TRADINGAGENTS_MAX_AUTH_FAILURES=5
TRADINGAGENTS_AUTH_LOCK_SECONDS=900
